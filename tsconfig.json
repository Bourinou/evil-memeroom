{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "shared/**/*.mjs",
    "shared/**/*.cjs",
    "shared/**/*.d.ts",
    "desktop/**/*.mjs",
    "desktop/**/*.cjs",
    "server/**/*.mjs",
    "tests/contracts.ts"
  ]
}
