{
  "name": "memeroom",
  "version": "0.6.0",
  "description": "Des réactions en direct, par-dessus votre écran.",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "Rose Roubaud",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server/index.mjs",
    "rooms": "node server/admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:focused": "node scripts/test-desktop.mjs --focused",
    "check": "node scripts/check.mjs",
    "check:types": "tsc --noEmit",
    "test:antivirus": "node --test tests/antivirus.e2e.mjs",
    "test:profile": "node tests/profile.e2e.mjs",
    "bench": "node scripts/benchmark.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{mjs,cjs,js,ts,json,css,html,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{mjs,cjs,js,ts,json,css,html,yaml,yml}\"",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "electron-builder --mac zip --arm64 --x64 --publish never",
    "dist:dir": "electron-builder --win --dir --x64",
    "dist:fork": "electron-builder --config scripts/fork-config.cjs --publish never",
    "stage:releases": "node scripts/stage-releases.mjs",
    "pack:server": "node scripts/pack-server.mjs",
    "test:fullscreen": "node tests/fullscreen.e2e.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "10.10.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "17.12.0",
    "js-yaml": "4.3.2",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "fr.memeroom.desktop",
    "productName": "MemeRoom",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "public/**",
      "server/**",
      "shared/**",
      "package.json",
      "LICENSE",
      "AUTHORS.md"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "public/icon-linux.png",
      "executableName": "memeroom",
      "artifactName": "MemeRoom-${version}-Linux-${arch}.${ext}"
    },
    "appImage": {
      "executableArgs": []
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.social-networking",
      "icon": "public/icon-mac.png",
      "identity": null,
      "artifactName": "MemeRoom-${version}-Mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://memeroom.tonamielarose.fr/releases/",
        "useMultipleRangeRequest": false
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MemeRoom-Setup-${version}.exe",
      "shortcutName": "MemeRoom",
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false
    }
  },
  "homepage": "https://memeroom.tonamielarose.fr"
}
