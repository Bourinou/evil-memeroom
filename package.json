{
  "name": "evil-memeroom",
  "desktopName": "evil-memeroom",
  "version": "0.6.0",
  "description": "Des réactions en direct, par-dessus votre écran.",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "Rose Roubaud <dimitripape1@gmail.com>",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop.e2e.mjs",
    "check": "node scripts/check.mjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb pacman --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:dir": "electron-builder --win --dir --x64",
    "stage:releases": "node scripts/stage-releases.mjs",
    "pack:server": "node scripts/pack-server.mjs",
    "test:fullscreen": "node tests/fullscreen.e2e.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "js-yaml": "4.3.2",
    "playwright": "^1.63.0",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "fr.memeroom.desktop",
    "productName": "evil memeroom",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "public/**",
      "server/**",
      "shared/**",
      "package.json",
      "LICENSE",
      "AUTHORS.md"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "maintainer": "Bourinou <dimitripape1@gmail.com>",
      "category": "Network",
      "icon": "public/icon-linux.png",
      "executableName": "evil-memeroom",
      "syncDesktopName": true,
      "artifactName": "evil-memeroom-${version}-Linux-${arch}.${ext}"
    },
    "deb": {
      "maintainer": "Bourinou <dimitripape1@gmail.com>"
    },
    "appImage": {
      "executableArgs": []
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "icon": "public/icon-mac.png",
      "identity": null,
      "artifactName": "evil-memeroom-${version}-Mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://memeroom.tonamielarose.fr/releases/",
        "useMultipleRangeRequest": false
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "evil-memeroom-Setup-${version}.exe",
      "shortcutName": "evil memeroom",
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false
    }
  },
  "homepage": "https://github.com/Bourinou/evil-memeroom"
}
